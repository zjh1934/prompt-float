<?xml version="1.0" encoding="utf-8"?>
<!-- 球 ↔ 框是同一个 View（两个层级里的第二级）。
     展开时这个容器从球的 56dp 圆形，用 ValueAnimator 插值到「固定一整排」的框。

     刻意没有：标题、蓝色竖条、收起 ✕、任何解释性文字。
     收起 = 点框外任意处（ACTION_OUTSIDE，通用范式）；点某条 chip = 插入并收起。
     宽度固定屏宽-32dp：哪怕只有一条 chip，也是完整一排，不会出现「没地方点」。
     长按 chip 的全文预览是**另一个临时气泡窗口**，不在这个布局里，不撑大主框、不进第三级。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/morphRoot"
    android:layout_width="56dp"
    android:layout_height="56dp"
    android:clickable="true"
    android:focusable="false">

    <!-- 球形态：展开动画里淡出 -->
    <TextView
        android:id="@+id/morphBallLabel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/ball_label"
        android:textColor="#FFFFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- 框的内容：展开动画里淡入，永远只有这一排 chips -->
    <FrameLayout
        android:id="@+id/contentRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:padding="10dp">

        <HorizontalScrollView
            android:id="@+id/chipRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="false"
            android:fadingEdgeLength="24dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/chipContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </FrameLayout>
</FrameLayout>
